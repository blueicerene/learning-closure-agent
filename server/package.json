{
  "name": "learning-closure-server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:section91": "tsx src/tests/section91Fixture.ts",
    "test:section92": "tsx src/tests/section92Fixture.ts",
    "test:vocab": "node --import tsx src/tests/vocabFixture.ts",
    "test:quiz-feedback-checkpoint": "node --import tsx src/tests/feedbackEnrichmentCheckpoint.ts",
    "test:question-quality-focus": "node --import tsx src/tests/questionQualityFocusCheckpoint.ts",
    "test:question-quality-focus-http": "node --import tsx src/tests/questionQualityFocusHttp.ts",
    "test:focus-round-http": "node --import tsx src/tests/focusRoundPersistenceHttp.ts",
    "test:fallback-quality-audit": "node --import tsx src/tests/fallbackQualityAudit.ts",
    "vocab:feedback-audit": "node --import tsx src/scripts/vocabFeedbackGovernance.ts",
    "vocab:feedback-enrich": "node --import tsx src/scripts/vocabFeedbackGovernance.ts --apply",
    "vocab:question-quality-focus": "node --import tsx src/scripts/questionQualityFocusMigration.ts",
    "test:daily-plan-release": "node --import tsx src/tests/dailyPlanRelease.ts",
    "test:daily-plan-real-path": "node --import tsx src/tests/dailyPlanRelease.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
