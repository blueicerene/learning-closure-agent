OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
USE_OPENAI_LEGAL_LOOKUP=true
OPENAI_LEGAL_LOOKUP_MODEL=gpt-4.1-mini
USE_MOCK_LLM=true
DEBUG_LLM=false
OBSIDIAN_INBOX_PATH=/path/to/ObsidianVault/Learning Inbox
LEARNING_LOG_PATH=/path/to/ObsidianVault/Learning Log/learning-log.json
LEARNING_CORRECTIONS_PATH=/path/to/project/output/classification-corrections.json
LEARNING_PROGRESS_PATH=/path/to/project/output/learning-progress.json
MAX_CAPTURE_CHARS=80000
PORT=3333
